<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 手表硬件声明：required=false 以便普通安卓设备也能安装，用于 480×480 圆形表盘模拟测试 -->
    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="false" />

    <!-- 蓝牙（Android 12+ 需 BLUETOOTH_CONNECT 运行时权限） -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- 通知访问由 service 的 BIND_NOTIFICATION_LISTENER_SERVICE 权限声明，无需 uses-permission -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Watch5Music">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 通知监听服务：读取手机同步到手表的媒体通知（需用户在设置→通知访问中授权） -->
        <service
            android:name=".media.MediaNotifService"
            android:exported="true"
            android:label="手机媒体同步"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
